PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collaborative_workspace
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_123456
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Cloud Object Storage (AWS S3 / Cloudflare R2)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional WebRTC TURN Relay (for strict NAT/corporate firewalls)
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
